# Copy this file to .env and adjust values as needed.

# App
APP_NAME=cts-drug-chatbot
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Chunking / retrieval / guardrail constants
MAX_CHUNK_TOKENS=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
CONFIDENCE_THRESHOLD=0.7
MAX_HISTORY_TURNS=10

# Data paths
PDF_UPLOAD_DIR=data/pdfs
CHROMA_PERSIST_DIR=data/vector_store
CHROMA_COLLECTION_NAME=drug_label_chunks

# Embeddings (sentence-transformers model name; downloaded on first use)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Ollama (local LLM). The model must be pulled with: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# Auto-search public drug labels (openFDA + DailyMed) when the local index
# has no confident match for the user's question
PUBLIC_LOOKUP_ENABLED=true
PUBLIC_LOOKUP_TIMEOUT_SECONDS=180
